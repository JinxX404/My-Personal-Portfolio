# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional Cloudflare Turnstile. Leave unset and the contact form works without a captcha.
# Set the site key here (it is public) and TURNSTILE_SECRET_KEY in the Netlify Functions environment.
VITE_TURNSTILE_SITE_KEY=

# Optional email alerts for new contact messages (Netlify environment, Functions scope).
# All three must be set; otherwise messages are saved without an email.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Optional server key for the contact function's insert (Netlify environment only,
# never a VITE_ variable). Without it the function inserts with the anon key.
SUPABASE_SERVICE_ROLE_KEY=
